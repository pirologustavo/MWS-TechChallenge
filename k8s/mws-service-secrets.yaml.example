# Copie e aplique após substituir todos os valores por segredos fortes.
apiVersion: v1
kind: Secret
metadata:
  name: mws-cliente-service-secret
type: Opaque
stringData:
  DB_USERNAME: cliente_app
  DB_PASSWORD: replace-me
  APP_KEY: replace-with-generated-laravel-key
  INTERNAL_API_TOKEN: replace-with-shared-long-random-token
