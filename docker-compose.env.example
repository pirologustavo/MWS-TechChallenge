# Copy to .env for local Docker Compose overrides; use random values outside development.
# Keep this equal to the password on an existing MySQL volume.
MYSQL_ROOT_PASSWORD=root
LEGACY_DB_ROOT_PASSWORD=root
INTERNAL_API_TOKEN=replace-with-long-random-service-token
OS_APPROVAL_SECRET=replace-with-long-random-approval-secret
MONOLITO_URL=http://localhost:8080
CLIENTE_DB_PASSWORD=local-cliente-change-me
VEICULO_DB_PASSWORD=local-veiculo-change-me
ESTOQUE_DB_PASSWORD=local-estoque-change-me
FUNCIONARIO_DB_PASSWORD=local-funcionario-change-me
OS_DB_PASSWORD=local-os-change-me
