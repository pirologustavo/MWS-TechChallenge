    {
      "name": "02 — Contratos internos",
      "description": "",
      "item": [
        {
          "name": "Validar token internamente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlation_id}}"
              },
              {
                "key": "X-Internal-Token",
                "value": "{{internal_token}}"
              }
            ],
            "url": {
              "raw": "{{funcionario_base_url}}/api/internal/v1/token",
              "host": [
                "{{funcionario_base_url}}"
              ],
              "path": [
                "api",
                "internal",
                "v1",
                "token"
              ]
            },
            "description": "Exige Bearer e X-Internal-Token. Token inválido pode retornar HTTP 200 com valid=false; ausência/erro no segredo interno retorna 401.\n\nOs exemplos salvos são ilustrativos, derivados do contrato; não são respostas coletadas de produção."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!String(pm.variables.get('token') || '').trim()) throw new Error('Preencha token ou execute a etapa que captura esse valor.');",
                  "if (!String(pm.variables.get('internal_token') || '').trim()) throw new Error('Preencha internal_token ou execute a etapa que captura esse valor.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP esperado: 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    const data = pm.response.json();",
                  "    const scope = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "",
                  "pm.test('Token reconhecido', () => pm.expect(data.valid).to.eql(true));",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Exemplo ilustrativo — 200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "X-Correlation-ID",
                    "value": "{{correlation_id}}"
                  },
                  {
                    "key": "X-Internal-Token",
                    "value": "{{internal_token}}"
                  }
                ],
                "url": {
                  "raw": "{{funcionario_base_url}}/api/internal/v1/token",
                  "host": [
                    "{{funcionario_base_url}}"
                  ],
                  "path": [
                    "api",
                    "internal",
                    "v1",
                    "token"
