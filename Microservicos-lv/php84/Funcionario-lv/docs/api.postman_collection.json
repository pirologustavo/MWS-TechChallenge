  "item": [
    {
      "name": "00 — Acesso e disponibilidade",
      "description": "Execute o login após selecionar o ambiente MWS — Apresentação. Credenciais e segredos são preenchidos localmente.",
      "item": [
        {
          "name": "Login — capturar token compartilhado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "{{correlation_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{funcionario_base_url}}/api/login",
              "host": [
                "{{funcionario_base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Autentica na API Funcionário. O token retornado é salvo como token no ambiente selecionado e reutilizado nas cinco collections. A aplicação usa tokens Sanctum, não JWT. Sem ambiente, o token fica apenas nesta collection.\n\nOs exemplos salvos são ilustrativos, derivados do contrato; não são respostas coletadas de produção.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"{{usr}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!String(pm.variables.get('usr') || '').trim()) throw new Error('Preencha usr ou execute a etapa que captura esse valor.');",
                  "if (!String(pm.variables.get('password') || '').trim()) throw new Error('Preencha password ou execute a etapa que captura esse valor.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP esperado: 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    const data = pm.response.json();",
                  "    const scope = pm.environment.name ? pm.environment : pm.collectionVariables;",
                  "pm.test('Token emitido', () => pm.expect(data.token).to.be.a('string').and.not.empty);",
                  "{ const value = data.token; if (value !== undefined && value !== null) scope.set('token', String(value)); }",
                  "",
                  "}"
                ]
              }
            }
          ],
          "response": [
