services:
    app-cliente:
        build:
            context: .
            dockerfile: Dockerfile
        container_name: cliente-lv-api
        restart: unless-stopped
        working_dir: /var/www
        volumes:
            - .:/var/www
        networks:
            - mws-network

    cliente-lv:
        image: nginx:alpine
        container_name: cliente-lv
        restart: unless-stopped
        ports:
            - "8001:80"
        volumes:
            - .:/var/www
            - ./nginx.conf:/etc/nginx/conf.d/default.conf
        depends_on:
            - app-cliente
        networks:
            - mws-network

networks:
    mws-network:
        external: true
        name: monolito_mws-network
